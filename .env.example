# ACMERD Image Manager - 环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，不会提交

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # 仅 Worker 侧使用，绝不进前端

# Supabase Database（本地 migration 直连用）
DATABASE_URL=

# Cloudflare（Worker 部署）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 前端公开变量（Vite）
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
